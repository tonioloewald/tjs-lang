#!/bin/sh
#
# Pre-tag gate: the FULL test suite must pass before a version tag can ship.
#
# Git has no `git tag` hook, so this fires on `git push` and gates only the pushes
# that carry a tag ref. Publishing is done from the pushed tag, so gating the tag's
# arrival at the remote is the real release gate — you can create a local tag
# freely, you just can't push (and therefore can't ship) one with a red suite.
#
# Why the FULL suite and not `test:fast`: test:fast sets SKIP_LLM_TESTS=1 and
# SKIP_BENCHMARKS=1 — exactly the two categories most likely to rot unseen. A
# benchmark drifted to a 27x flake precisely because CI never ran it. For a
# foundational project the full run is the tag gate (CLAUDE.md → "Full run before
# tagging"; docs/lm-studio-setup.md for the LM Studio prerequisite).
#
# Non-tag pushes (branches, main) are untouched — this exits immediately for them.
#
# Escape hatch: `git push --no-verify` skips this. Only for a tag whose full suite
# you have ALREADY run green by hand — never to dodge a real failure.

set -e

fail() {
  echo ""
  echo "  pre-push: $1"
  echo ""
  exit 1
}

# Does this push carry a real (non-delete) tag ref? pre-push feeds one line per ref
# on stdin: "<local ref> <local sha> <remote ref> <remote sha>". A delete has an
# all-zero local sha, which we skip.
# The COMMITS being tagged — peeled, since an annotated tag's sha is the tag object, not the
# commit. This hook used to gate HEAD instead: it compared the stamp to `git rev-parse HEAD`
# and ran the suite on the working tree. For a retroactive tag — a case this hook exists
# for — that tested the WRONG CODE and then cleared a tag naming different code. Found
# 2026-09-25 tagging v0.14.0-rc.0 at 9bd4519 with HEAD three commits later.
tagged=""
while read -r local_ref local_sha _remote_ref _remote_sha; do
  case "$local_ref" in
  refs/tags/*)
    case "$local_sha" in
    *[!0]*) # any non-zero char ⇒ a real tag, not a delete
      tagged="$tagged $(git rev-parse "$local_sha^{commit}")" ;;
    esac
    ;;
  esac
done

[ -z "$tagged" ] && exit 0

# ORDER CHANGED 2026-09-13: the release is PUBLISH, then tag.
#
# That makes this hook a BACKSTOP rather than the primary gate. The primary gate is
# `scripts/release-gate.ts`, which runs the same full suite inside `prepublishOnly` — before
# `npm publish`, which is the step that cannot be undone. Gating the tag alone would fire
# after the release was already public.
#
# This hook still matters for the case the new order does not cover: a tag pushed by someone
# who has NOT just published — a retroactive tag, a tag from another machine, a tag for a
# version published with --ignore-scripts.
#
# The stamp keeps it from being pure waste. `release-gate.ts` writes `.release-gate` naming
# the SHA it verified; if that names the commit being tagged, the suite has already run on
# exactly this code and re-running it would cost ~3.5 minutes to learn nothing. A hook that
# wastes your time gets --no-verify'd, and then it protects nobody.
#
# Deliberately strict: same SHA or run it. Not "recent", not "same version" — the only thing
# that makes a re-run redundant is that the identical code was tested.
ROOT="$(git rev-parse --show-toplevel)"
STAMP="$ROOT/.release-gate"
HEAD_SHA="$(git rev-parse HEAD)"
stamped="$( [ -f "$STAMP" ] && head -n1 "$STAMP" || true )"
# Every SHA a full suite has passed for on this machine. `.release-gate` names only the
# LATEST — a later `release:ready` overwrites it — so the ledger is what remembers that the
# commit you published from earlier was verified. Written by release-gate.ts and by this
# hook; gitignored, like the stamp.
LEDGER="$ROOT/.release-gate-verified"

needs=""
for sha in $tagged; do
  if [ "$sha" = "$stamped" ] || { [ -f "$LEDGER" ] && grep -qx "$sha" "$LEDGER"; }; then
    echo "pre-push: full suite already green for $(echo "$sha" | cut -c1-7) (release-gate record) — not re-running."
  else
    needs="$needs $sha"
  fi
done
[ -z "$needs" ] && exit 0

echo "pre-push: tag detected — running the FULL suite before it ships (~3 min)."

# The full suite includes LLM integration tests, which need an OpenAI-compatible
# server up with a chat + embedding model. A cold server fails the first run on
# model load, so check reachability first and give a clear message instead of a
# wall of failures.
#
# The BACKEND IS A CONFIG CHOICE, not a constant — LM Studio/Bionic on :1234, MLX
# on :10240, anything else via TJS_LLM_BASE_URL. Hardcoding the port here would
# fail a push for a perfectly healthy setup, which is the same defect that made the
# demo tests silently probe nothing when the server was MLX.
LLM_URL="${TJS_LLM_BASE_URL:-http://localhost:1234/v1}"
if ! curl -s --max-time 5 "$LLM_URL/models" >/dev/null 2>&1; then
  fail "no LLM server reachable at $LLM_URL — the full suite needs a chat +
  embedding model loaded (docs/lm-studio-setup.md, docs/mlx-setup.md). Start it
  (and warm the models), or set TJS_LLM_BASE_URL, then push the tag again. To ship
  anyway after running the suite green another way: git push --no-verify"
fi

# Full suite: no SKIP_LLM_TESTS, no SKIP_BENCHMARKS.
#
# Vision tests self-skip when NO vision model is reachable — that is expected and does not
# fail the run. They do NOT self-skip when one is present but the probe misjudges it: that
# combination (a vision model loaded, judged blind by a content-based probe) is what turned
# this gate red at 0.13.0-beta.1 while `test:fast` stayed green. If a vision test FAILS
# rather than skips, the probe is wrong, not the model — see src/batteries/audit.ts.
for sha in $needs; do
  if [ "$sha" = "$HEAD_SHA" ] && [ -z "$(git status --porcelain)" ]; then
    # The tag names exactly the checked-out, clean tree: test it in place.
    bun test ||
      fail "full test suite failed — do NOT ship this tag. Fix the failures above,
  re-tag if needed, and push again."
  else
    # The tag names OTHER code than the working tree. Test THAT commit, in a throwaway
    # worktree with its own install and build — the only way the suite sees what the tag
    # names. Slower, and correct; the fast path is a release-gate record for the SHA.
    wt="$(mktemp -d)/tag-$(echo "$sha" | cut -c1-7)"
    echo "pre-push: tag names $(echo "$sha" | cut -c1-7), not the working tree — testing it in $wt"
    git worktree add --detach "$wt" "$sha" >/dev/null 2>&1 ||
      fail "could not create a worktree for $sha"
    ok=0
    (cd "$wt" && bun install --frozen-lockfile && bun run make && bun test) && ok=1
    git worktree remove --force "$wt" >/dev/null 2>&1 || true
    [ "$ok" -eq 1 ] ||
      fail "full test suite failed for $(echo "$sha" | cut -c1-7) — do NOT ship this tag."
  fi
  echo "$sha" >>"$LEDGER"
done
echo "pre-push: full suite green — tag cleared to ship."
exit 0
